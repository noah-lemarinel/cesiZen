{% extends 'base.html.twig' %}
{% block title %}CesiZen - Accueil{% endblock %}

{% block body %}
    <main class="container mx-auto px-6 py-12">
        <!-- Hero -->
        <section
            class="bg-white rounded-2xl shadow-lg p-8 md:p-12 mb-8 transform transition-all duration-300 hover:shadow-2xl dark:bg-gray-900">
            <div class="md:flex md:items-center md:justify-between gap-8">
                <div class="md:w-2/3">
                    <h2 class="text-3xl md:text-4xl font-bold text-darkblue mb-4 dark:text-white">Mieux comprendre et
                        gérer
                        votre stress</h2>
                    <p class="text-gray-700 mb-6 dark:text-gray-300">CesiZen vous propose des outils simples et éprouvés
                        pour suivre vos émotions, pratiquer la respiration et accéder à des ressources pédagogiques.</p>
                    <div class="flex gap-3">
                        <a href="/register"
                           class="inline-block bg-secondary text-white px-5 py-3 rounded-lg font-semibold shadow hover:bg-darkblue transition-colors duration-200 transform hover:-translate-y-0.5">Créer
                            un Compte</a>
                        <a href="#"
                           class="inline-block bg-white border border-gray-200 text-darkblue px-5 py-3 rounded-lg font-semibold hover:shadow-md transition-all duration-200 dark:bg-gray-800 dark:border-gray-700 dark:text-white">Découvrir</a>
                    </div>
                </div>
                <div class="md:w-1/3 mt-6 md:mt-0">
                    <!-- illustrative card -->
                    <div
                        class="bg-gradient-to-br from-primary to-white rounded-xl p-6 shadow-md transition-transform duration-300 hover:scale-105 dark:from-secondary dark:to-gray-800">
                        <h3 class="text-lg font-semibold text-darkblue mb-2 dark:text-white">Tracker d'Émotions</h3>
                        <p class="text-sm text-darkblue/80 mb-4 dark:text-gray-300">Notez vos émotions quotidiennement
                            et
                            visualisez vos tendances au fil du temps.</p>
                        <a href="#"
                           class="inline-block bg-darkblue text-white px-4 py-2 rounded-md font-medium transition-colors duration-200">Accéder
                            au tracker</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <article
                class="bg-white rounded-xl p-6 shadow-sm hover:shadow-lg transform hover:-translate-y-1 transition-all duration-200 dark:bg-gray-800">
                <h4 class="font-semibold text-lg mb-2 dark:text-white">Tracker d'Émotions</h4>
                <p class="text-sm text-gray-600 dark:text-gray-300">Suivez vos humeurs et identifiez les déclencheurs
                    grâce
                    à un journal simple et rapide.</p>
            </article>

            <article
                class="bg-white rounded-xl p-6 shadow-sm hover:shadow-lg transform hover:-translate-y-1 transition-all duration-200 dark:bg-gray-800">
                <h4 class="font-semibold text-lg mb-2 dark:text-white">Exercices de Respiration</h4>
                <p class="text-sm text-gray-600 dark:text-gray-300">Exercices guidés basés sur la cohérence cardiaque
                    pour
                    réduire le stress en quelques minutes.</p>
            </article>

            <article
                class="bg-white rounded-xl p-6 shadow-sm hover:shadow-lg transform hover:-translate-y-1 transition-all duration-200 dark:bg-gray-800">
                <h4 class="font-semibold text-lg mb-2 dark:text-white">Ressources Pédagogiques</h4>
                <p class="text-sm text-gray-600 dark:text-gray-300">Articles, guides et astuces pour mieux comprendre la
                    santé mentale et les bonnes pratiques.</p>
            </article>
        </section>

        <!-- Callout / CTA -->
        <section
            class="bg-secondary text-white rounded-xl p-6 md:p-8 mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 dark:bg-primary">
            <div>
                <h3 class="text-xl font-bold">Commencez dès maintenant</h3>
                <p class="text-sm opacity-90">Créez un compte gratuit et commencez à suivre votre bien-être
                    aujourd'hui.</p>
            </div>
            <div class="flex gap-3">
                <a href="/register"
                   class="bg-white text-secondary px-4 py-2 rounded-md font-semibold shadow hover:scale-105 transform transition duration-200 dark:bg-gray-800 dark:text-white">Créer
                    un Compte</a>
                <a href="/login"
                   class="bg-white/20 border border-white/30 text-white px-4 py-2 rounded-md font-semibold hover:bg-white/30 transition-colors duration-200">Se
                    Connecter</a>
            </div>
        </section>

        <!-- Additional info / report sample -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white rounded-xl p-6 shadow-md dark:bg-gray-800">
                <h4 class="font-semibold text-lg mb-3 dark:text-white">Rapports & Tendances</h4>
                <p class="text-sm text-gray-600 dark:text-gray-300">Visualisez vos progrès au fil du temps avec des
                    graphiques clairs et des résumés intelligents.</p>
                <a href="#"
                   class="mt-4 inline-block text-secondary font-medium hover:underline transition dark:text-primary">Voir
                    un
                    exemple de rapport</a>
            </div>

            <div class="bg-white rounded-xl p-6 shadow-md dark:bg-gray-800">
                <h4 class="font-semibold text-lg mb-3 dark:text-white">Support & Confidentialité</h4>
                <p class="text-sm text-gray-600 dark:text-gray-300">Vos données sont privées et stockées en toute
                    sécurité.
                    Accédez au support à tout moment.</p>
                <a href="#"
                   class="mt-4 inline-block text-secondary font-medium hover:underline transition dark:text-primary">En
                    savoir plus</a>
            </div>
        </section>
    </main>
{% endblock %}
