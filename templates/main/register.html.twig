{% extends 'base.html.twig' %}

{% block title %}S'inscrire - CesiZen{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-lightgray dark:bg-darkblue">
  <div class="bg-white rounded-xl shadow-md p-8 w-full max-w-md dark:bg-gray-800">
    <h2 class="text-2xl font-bold mb-4 dark:text-white">Créer un compte</h2>

    {% for type, messages in app.flashes %}
      {% for message in messages %}
        <div class="mb-4 p-3 rounded text-sm {% if type == 'error' %}bg-red-100 text-red-800{% else %}bg-green-100 text-green-800{% endif %}">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    <form id="register-form" method="post">
      <div class="mb-4">
        <label for="name" class="block text-sm font-medium mb-1 dark:text-white">Nom d'utilisateur</label>
        <input id="name" name="name" type="text" value="{{ name|default('') }}" class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:text-white">
      </div>

      <div class="mb-4">
        <label for="email" class="block text-sm font-medium mb-1 dark:text-white">Email</label>
        <input id="email" name="email" type="email" value="{{ email|default('') }}" class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:text-white" required>
      </div>

      <div class="mb-4">
        <label for="password" class="block text-sm font-medium mb-1 dark:text-white">Mot de passe</label>
        <input id="password" name="password" type="password" class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:text-white" required>
      </div>

      <div class="flex items-center justify-between">
        <button type="submit" class="bg-secondary text-white px-4 py-2 rounded-md font-semibold">S'inscrire</button>
        <a href="{{ path('app_login') }}" class="text-sm text-gray-600 hover:underline dark:text-gray-300">Déjà un compte ? Se connecter</a>
      </div>
    </form>
  </div>
</div>
{% endblock %}
