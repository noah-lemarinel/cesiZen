
{# templates/emotion_tracker/add.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Add Emotion{% endblock %}

{% block body %}
    <div class="container mx-auto px-6 py-8">
        <div class="max-w-2xl mx-auto bg-white/70 dark:bg-gray-800 rounded-lg p-6 shadow-lg">
            <div class="flex items-start justify-between mb-6">
                <h1 class="text-2xl font-semibold">Ajouter une émotion</h1>
                <div class="flex items-center gap-3">
                    <div id="selected-color" class="w-12 h-12 rounded-md border-2" style="background: transparent; border-style: dashed;"></div>
                    <div class="text-sm text-gray-600 dark:text-gray-300">Aperçu</div>
                </div>
            </div>

            <!-- Connection status indicator -->
            <div id="connection-status" class="mb-4 p-3 rounded bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-100 text-sm hidden">
                Vous êtes <strong id="status-text">en ligne</strong>. Les émotions seront enregistrées instantanément.
            </div>
            <div id="offline-warning" class="mb-4 p-3 rounded bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-100 text-sm hidden">
                Vous êtes <strong>hors ligne</strong>. Les émotions seront sauvegardées localement et synchronisées quand vous serez en ligne.
            </div>

            {{ form_start(form, {'attr': {'class': 'space-y-6', 'id': 'emotion-form'}}) }}

            <div class="space-y-4">
                <div>
                    {{ form_label(form.emotion, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1'}}) }}
                    {{ form_errors(form.emotion) }}
                    {{ form_widget(form.emotion, { 'attr': {'class': 'w-full rounded-md border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-secondary'} } ) }}
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Choisissez une émotion pour lier cette entrée.</p>
                </div>

                <div>
                    {{ form_label(form.notes, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1'}}) }}
                    {{ form_errors(form.notes) }}
                    {{ form_widget(form.notes, { 'attr': {'class': 'w-full rounded-md border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-secondary', 'rows': 4 } } ) }}
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Ajoutez des notes (optionnel).</p>
                </div>

                <div class="pt-2">
                    <button type="submit" class="bg-secondary hover:bg-secondary-dark text-white px-4 py-2 rounded-md shadow">Enregistrer</button>
                </div>
            </div>

            {{ form_end(form) }}

            <!-- Local storage entries -->
            <div id="local-entries" class="mt-8 pt-6 border-t border-gray-300 dark:border-gray-700">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-semibold">Entrées en attente de synchronisation</h2>
                    <button id="sync-btn" type="button" class="bg-primary hover:bg-primary/90 text-white px-3 py-1 rounded text-sm hidden">Synchroniser</button>
                </div>
                <div id="local-entries-list" class="space-y-3"></div>
                <p id="no-local-entries" class="text-sm text-gray-500 dark:text-gray-400">Aucune entrée en attente.</p>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Select element id generated by Symfony form
            const select = document.getElementById('{{ form.emotion.vars.id }}');
            const preview = document.getElementById('selected-color');
            const form = document.getElementById('emotion-form');
            const connectionStatus = document.getElementById('connection-status');
            const offlineWarning = document.getElementById('offline-warning');
            const syncBtn = document.getElementById('sync-btn');
            const localEntriesList = document.getElementById('local-entries-list');
            const noLocalEntries = document.getElementById('no-local-entries');

            if (!select || !preview) return;

            // Update connection status display
            function updateConnectionStatus() {
                const isOnline = navigator.onLine;
                if (isOnline) {
                    connectionStatus.classList.remove('hidden');
                    offlineWarning.classList.add('hidden');
                } else {
                    connectionStatus.classList.add('hidden');
                    offlineWarning.classList.remove('hidden');
                }
            }

            // Update local entries display
            function updateLocalEntriesDisplay() {
                const entries = window.emotionTrackerStorage.getAllEntries();
                localEntriesList.innerHTML = '';

                if (entries.length === 0) {
                    noLocalEntries.classList.remove('hidden');
                    syncBtn.classList.add('hidden');
                    return;
                }

                noLocalEntries.classList.add('hidden');
                syncBtn.classList.remove('hidden');

                entries.forEach(entry => {
                    const formatted = window.emotionTrackerStorage.formatEntryForDisplay(entry);
                    const html = `
                        <div class="p-3 bg-gray-100 dark:bg-gray-700 rounded text-sm">
                            <div class="flex items-center justify-between">
                                <div>
                                    <div class="font-medium">${formatted.emotionName}</div>
                                    <div class="text-xs text-gray-600 dark:text-gray-400">${formatted.formattedDate}</div>
                                    ${entry.synced ? '<div class="text-xs text-green-600 dark:text-green-400">✓ Synchronisée</div>' : '<div class="text-xs text-orange-600 dark:text-orange-400">En attente...</div>'}
                                </div>
                                <button type="button" class="text-red-600 hover:text-red-800 dark:hover:text-red-400 text-xs delete-local-entry" data-id="${formatted.id}">Supprimer</button>
                            </div>
                            ${formatted.notes ? `<div class="mt-2 text-xs text-gray-700 dark:text-gray-300">${formatted.notes}</div>` : ''}
                        </div>
                    `;
                    localEntriesList.insertAdjacentHTML('beforeend', html);
                });

                // Add delete handlers
                document.querySelectorAll('.delete-local-entry').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.preventDefault();
                        const id = btn.getAttribute('data-id');
                        if (confirm('Supprimer cette entrée ?')) {
                            window.emotionTrackerStorage.removeEntry(id);
                            updateLocalEntriesDisplay();
                        }
                    });
                });
            }

            function updatePreview() {
                const opt = select.options[select.selectedIndex];
                const color = opt ? opt.getAttribute('data-color') : null;
                if (color) {
                    preview.style.background = color;
                    preview.style.borderStyle = 'solid';
                } else {
                    preview.style.background = 'transparent';
                    preview.style.borderStyle = 'dashed';
                }
            }

            // Initialize
            updatePreview();
            updateConnectionStatus();
            updateLocalEntriesDisplay();

            // Update on change
            select.addEventListener('change', updatePreview);

            // Connection status listener
            window.addEventListener('online', updateConnectionStatus);
            window.addEventListener('offline', updateConnectionStatus);

            // Form submission
            form.addEventListener('submit', async (e) => {
                e.preventDefault();

                const emotionId = select.value;
                const emotionName = select.options[select.selectedIndex].textContent;
                const notes = document.getElementById('{{ form.notes.vars.id }}').value;

                if (!emotionId) {
                    alert('Veuillez sélectionner une émotion');
                    return;
                }

                if (navigator.onLine) {
                    // Submit form normally when online
                    form.submit();
                } else {
                    // Save to local storage when offline
                    window.emotionTrackerStorage.addEntry(emotionId, emotionName, notes);

                    // Reset form
                    form.reset();
                    updatePreview();
                    updateLocalEntriesDisplay();

                    alert('Émotion enregistrée localement. Elle sera synchronisée quand vous serez en ligne.');
                }
            });

            // Sync button
            syncBtn.addEventListener('click', async (e) => {
                e.preventDefault();
                syncBtn.disabled = true;
                syncBtn.textContent = 'Synchronisation...';

                const result = await window.emotionTrackerStorage.syncWithServer();

                if (result.success) {
                    alert(`${result.synced} émotion(s) synchronisée(s) avec succès!`);
                    updateLocalEntriesDisplay();
                    // Optionally reload the page
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert('Erreur lors de la synchronisation: ' + result.error);
                    syncBtn.disabled = false;
                    syncBtn.textContent = 'Synchroniser';
                }
            });
        });
    </script>
{% endblock %}
