{# templates/emotion_tracker/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Tracker d'Émotions{% endblock %}

{% block body %}
    <div class="container mx-auto px-6 py-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-3xl font-semibold">Tracker d'Émotions</h1>
                <p class="text-sm text-gray-600 dark:text-gray-300">Visualisez vos émotions récentes.</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="{{ path('emotion_tracker_add') }}" class="bg-secondary text-white px-4 py-2 rounded shadow">Ajouter une émotion</a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            {% if emotionForm and app.user and app.user.isAdmin() %}
            {# Create Emotion Form - Admin Only #}
            <aside class="md:col-span-1 bg-white/60 dark:bg-gray-800 rounded p-4 shadow">
                <h2 class="text-lg font-medium mb-3">Créer une nouvelle émotion</h2>
                {{ form_start(emotionForm, {'attr': {'class': 'space-y-3'}}) }}
                    <div>
                        {{ form_label(emotionForm.name, 'Nom') }}
                        {{ form_widget(emotionForm.name, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-white'}}) }}
                        {{ form_errors(emotionForm.name) }}
                    </div>
                    <div>
                        {{ form_label(emotionForm.color, 'Couleur') }}
                        {{ form_widget(emotionForm.color, {'attr': {'class': 'w-full h-10 px-1 border border-gray-300 dark:border-gray-600 rounded'}}) }}
                        {{ form_errors(emotionForm.color) }}
                    </div>
                    <button type="submit" class="w-full bg-primary text-white px-4 py-2 rounded shadow hover:bg-primary/90">
                        Créer l'émotion
                    </button>
                {{ form_end(emotionForm) }}
            </aside>

            {# Emotions List - Adjusted layout #}
            <aside class="{% if emotionForm and app.user and app.user.isAdmin() %}md:col-span-3{% else %}md:col-span-4{% endif %} bg-white/60 dark:bg-gray-800 rounded p-4 shadow">
                <h2 class="text-lg font-medium mb-3">Palette d'émotions</h2>
                <ul class="space-y-2">
                    {% for entry in emotions %}
                        {% set emotion = entry.emotion %}
                        {% set color = emotion.color is not empty ? emotion.color : palette[loop.index0 % palette|length] %}
                        <li class="flex items-center gap-3">
                            <span class="w-4 h-4 rounded-full" style="background: {{ color }}"></span>
                            <div>
                                <div class="font-medium">{{ emotion.name }}</div>
                                <div class="text-xs text-gray-600 dark:text-gray-400">{{ emotion.description }}</div>
                                <div class="text-xs text-gray-500 dark:text-gray-500">{{ entry.createdAt|format_datetime('long', 'short') }}</div>
                            </div>
                        </li>
                    {% else %}
                        <li class="text-sm text-gray-500">Aucune émotion trouvée. Ajoutez-en une !</li>
                    {% endfor %}
                </ul>
            </aside>
            {% else %}
            {# Emotions List - Full width for non-admins #}
            <aside class="md:col-span-4 bg-white/60 dark:bg-gray-800 rounded p-4 shadow">
                <h2 class="text-lg font-medium mb-3">Palette d'émotions</h2>
                <ul class="space-y-2">
                    {% for entry in emotions %}
                        {% set emotion = entry.emotion %}
                        {% set color = emotion.color is not empty ? emotion.color : palette[loop.index0 % palette|length] %}
                        <li class="flex items-center gap-3">
                            <span class="w-4 h-4 rounded-full" style="background: {{ color }}"></span>
                            <div>
                                <div class="font-medium">{{ emotion.name }}</div>
                                <div class="text-xs text-gray-600 dark:text-gray-400">{{ emotion.description }}</div>
                                <div class="text-xs text-gray-500 dark:text-gray-500">{{ entry.createdAt|format_datetime('long', 'short') }}</div>
                            </div>
                        </li>
                    {% else %}
                        <li class="text-sm text-gray-500">Aucune émotion trouvée. Ajoutez-en une !</li>
                    {% endfor %}
                </ul>
            </aside>
            {% endif %}
        </div>

        {# Export emotion data to JS for the visualization script #}
        <script>
            window.EMOTIONS = [
                {% for entry in emotions %}
                    {% set emotion = entry.emotion %}
                    {
                        name: "{{ emotion.name|e('js') }}",
                        description: "{{ (emotion.description ?? '')|e('js') }}",
                        color: "{{ (emotion.color is not empty ? emotion.color : palette[loop.index0 % palette|length]) }}",
                        createdAt: "{{ entry.createdAt.format('Y-m-d H:i:s') }}"
                    }{{ loop.last ? '' : ',' }}
                {% endfor %}
            ];
        </script>
    </div>
{% endblock %}
