{# templates/emotion_tracker/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gestion des Émotions - Admin{% endblock %}

{% block body %}
    <div class="container mx-auto px-6 py-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-3xl font-semibold">Gestion des Émotions</h1>
                <p class="text-sm text-gray-600 dark:text-gray-300">Configurez la palette d'émotions disponibles.</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="{{ path('emotion_tracker_create') }}" class="bg-primary text-white px-4 py-2 rounded shadow hover:bg-primary/90">+ Créer une émotion</a>
                <a href="{{ path('emotion_tracker_journal') }}" class="bg-secondary text-white px-4 py-2 rounded shadow hover:bg-secondary/90">Mon Journal</a>
            </div>
        </div>

        <div class="bg-white/60 dark:bg-gray-800 rounded p-6 shadow">
            <h2 class="text-lg font-medium mb-4">Palette d'émotions ({{ emotions|length }})</h2>
            <div class="space-y-4">
                {% set primaryEmotions = emotions|filter((e) => e.parent is null) %}
                {% if primaryEmotions %}
                    {% for primary in primaryEmotions %}
                        {% set color = primary.color is not empty ? primary.color : '#888888' %}
                        <div class="border border-gray-300 dark:border-gray-600 rounded p-4 hover:shadow-md transition-shadow">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-3">
                                    <span class="w-6 h-6 rounded-full" style="background: {{ color }}"></span>
                                    <div>
                                        <div class="font-semibold text-lg">{{ primary.name }}</div>
                                        {% if primary.description %}<p class="text-sm text-gray-600 dark:text-gray-400">{{ primary.description }}</p>{% endif %}
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs bg-gray-200 dark:bg-gray-700 px-2 py-1 rounded">Primaire</span>
                                    <form method="post" action="{{ path('emotion_tracker_delete_emotion', {id: primary.id}) }}" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette émotion et ses sous-émotions ?');">
                                        <button type="submit" class="text-red-600 hover:text-red-800 dark:hover:text-red-400 text-xs font-medium px-2 py-1">✕ Supprimer</button>
                                    </form>
                                </div>
                            </div>

                            {% set children = emotions|filter((e) => e.parent and e.parent.id == primary.id) %}
                            {% if children %}
                                <div class="ml-8 space-y-2 pt-2 border-t border-gray-200 dark:border-gray-700">
                                    {% for child in children %}
                                        <div class="flex items-start justify-between">
                                            <div class="flex-grow">
                                                <div class="font-medium text-sm">{{ child.name }}</div>
                                                {% if child.description %}<p class="text-xs text-gray-600 dark:text-gray-400">{{ child.description }}</p>{% endif %}
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span class="text-xs bg-blue-200 dark:bg-blue-900 px-2 py-1 rounded flex-shrink-0">Secondaire</span>
                                                <form method="post" action="{{ path('emotion_tracker_delete_emotion', {id: child.id}) }}" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette émotion ?');">
                                                    <button type="submit" class="text-red-600 hover:text-red-800 dark:hover:text-red-400 text-xs font-medium px-2 py-1">✕</button>
                                                </form>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="text-center py-8 text-gray-600 dark:text-gray-400">
                        <p class="mb-4">Aucune émotion trouvée.</p>
                        <a href="{{ path('emotion_tracker_create') }}" class="inline-block bg-primary text-white px-6 py-2 rounded hover:bg-primary/90">
                            + Créer la première émotion
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
