{% extends 'base.html.twig' %}

{% block title %}Mon Compte - CesiZen{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-12">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-3xl font-bold mb-8">Mon Compte</h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Account Info Card -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4">Informations du Compte</h2>
                <div class="space-y-3">
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Email</p>
                        <p class="font-medium">{{ app.user.email }}</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Nom</p>
                        <p class="font-medium">{{ app.user.name ?? 'Non défini' }}</p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Statut</p>
                        <p class="font-medium">
                            {% if app.user.isAdmin %}
                                <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">Administrateur</span>
                            {% else %}
                                <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">Utilisateur</span>
                            {% endif %}
                        </p>
                    </div>
                </div>
                <a href="{{ path('app_account_edit') }}" class="block mt-6 bg-primary text-white px-4 py-2 rounded-lg hover:bg-secondary transition-colors text-center">
                    Modifier les Informations
                </a>
            </div>

            <!-- Password Card -->
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4">Sécurité</h2>
                <p class="text-gray-600 dark:text-gray-400 mb-4">Changez votre mot de passe pour sécuriser votre compte.</p>
                <a href="{{ path('app_account_password') }}" class="block bg-primary text-white px-4 py-2 rounded-lg hover:bg-secondary transition-colors text-center">
                    Changer le Mot de Passe
                </a>
            </div>
        </div>

        <!-- Danger Zone -->
        <div class="mt-8 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-6">
            <h2 class="text-xl font-semibold text-red-800 dark:text-red-200 mb-4">Zone Dangereuse</h2>
            <p class="text-gray-700 dark:text-gray-300 mb-4">Une fois votre compte supprimé, il ne peut pas être récupéré. Veuillez être certain avant de continuer.</p>

            <form method="POST" action="{{ path('app_account_delete') }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement votre compte ? Cette action est irréversible.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
                <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors">
                    Supprimer le Compte
                </button>
            </form>
        </div>

        {% if app.user.admin %}
        <div class="mt-8">
            <a href="{{ path('admin_users_index') }}" class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm6-11a2 2 0 11-4 0 2 2 0 014 0zm-1 6h6v-2a4 4 0 00-4-4h-2v6z" />
                </svg>
                Gérer les Utilisateurs
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}



