{% extends 'base.html.twig' %}

{% block title %}Changer le Mot de Passe - CesiZen{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-12">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-3xl font-bold mb-8">Changer le Mot de Passe</h1>

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            {% if app.flashes %}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-4 p-4 rounded-lg {% if type == 'success' %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endif %}

            <form method="POST" class="space-y-6">
                <div>
                    <label for="current_password" class="block text-sm font-medium mb-2">Mot de Passe Actuel</label>
                    <input type="password" id="current_password" name="current_password" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:border-gray-600">
                </div>

                <div>
                    <label for="new_password" class="block text-sm font-medium mb-2">Nouveau Mot de Passe</label>
                    <input type="password" id="new_password" name="new_password" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:border-gray-600">
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">Minimum 6 caractères</p>
                </div>

                <div>
                    <label for="confirm_password" class="block text-sm font-medium mb-2">Confirmer le Mot de Passe</label>
                    <input type="password" id="confirm_password" name="confirm_password" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary dark:bg-gray-700 dark:border-gray-600">
                </div>

                <div class="flex gap-4">
                    <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition-colors">
                        Changer le Mot de Passe
                    </button>
                    <a href="{{ path('app_account') }}" class="bg-gray-300 text-gray-800 px-6 py-2 rounded-lg hover:bg-gray-400 transition-colors">
                        Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

