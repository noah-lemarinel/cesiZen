{% extends 'base.html.twig' %}

{% block title %}Créer un Utilisateur - CesiZen{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-12">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-3xl font-bold mb-8">Créer un Nouvel Utilisateur</h1>

        {% if app.flashes %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 p-4 rounded-lg {% if type == 'success' %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        {% endif %}

        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
            {{ form_start(form) }}

            <div class="mb-6">
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                {% if form.name.vars.errors %}
                    <div class="text-red-600 text-sm mt-1">
                        {{ form_errors(form.name) }}
                    </div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {% if form.email.vars.errors %}
                    <div class="text-red-600 text-sm mt-1">
                        {{ form_errors(form.email) }}
                    </div>
                {% endif %}
            </div>

            <div class="mb-6">
                {{ form_label(form.password) }}
                {{ form_widget(form.password) }}
                {% if form.password.vars.errors %}
                    <div class="text-red-600 text-sm mt-1">
                        {{ form_errors(form.password) }}
                    </div>
                {% endif %}
            </div>

            <div class="mb-6">
                <label class="flex items-center gap-2">
                    {{ form_widget(form.isAdmin, {attr: {class: 'w-4 h-4'}}) }}
                    <span>{{ form_label(form.isAdmin) }}</span>
                </label>
                {% if form.isAdmin.vars.errors %}
                    <div class="text-red-600 text-sm mt-1">
                        {{ form_errors(form.isAdmin) }}
                    </div>
                {% endif %}
            </div>

            <div class="flex gap-4">
                <button type="submit" class="bg-primary text-white px-6 py-2 rounded-lg hover:bg-secondary transition-colors">
                    Créer l'Utilisateur
                </button>
                <a href="{{ path('admin_users_index') }}" class="bg-gray-300 text-gray-800 px-6 py-2 rounded-lg hover:bg-gray-400 transition-colors">
                    Annuler
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

