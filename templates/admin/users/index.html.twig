{% extends 'base.html.twig' %}

{% block title %}Gérer les Utilisateurs - CesiZen{% endblock %}

{% block body %}
<div class="container mx-auto px-6 py-12">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold">Gérer les Utilisateurs</h1>
        <a href="{{ path('admin_users_create') }}" class="bg-primary text-white px-4 py-2 rounded-lg hover:bg-secondary transition-colors">
            Créer un Utilisateur
        </a>
    </div>

    {% if app.flashes %}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-lg {% if type == 'success' %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    {% endif %}

    <!-- Search Form -->
    <div class="mb-6 bg-gray-50 dark:bg-gray-700 p-4 rounded-lg">
        <form method="GET" action="{{ path('admin_users_index') }}" class="flex gap-2">
            <input type="text" name="q" value="{{ search_query }}" placeholder="Rechercher par email ou nom..."
                   class="flex-1 px-4 py-2 border border-gray-300 rounded-lg dark:bg-gray-800 dark:border-gray-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-secondary">
            <button type="submit" class="bg-secondary text-white px-6 py-2 rounded-lg hover:opacity-90 transition-opacity">
                Rechercher
            </button>
            {% if search_query %}
                <a href="{{ path('admin_users_index') }}" class="bg-gray-400 text-white px-6 py-2 rounded-lg hover:bg-gray-500 transition-colors">
                    Réinitialiser
                </a>
            {% endif %}
        </form>
    </div>

    {% if search_query %}
        <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">Résultats de recherche pour "<strong>{{ search_query }}</strong>" ({{ users|length }} résultat{{ users|length > 1 ? 's' : '' }})</p>
    {% endif %}

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
        <table class="w-full">
            <thead class="bg-gray-100 dark:bg-gray-700">
                <tr>
                    <th class="px-6 py-3 text-left text-sm font-semibold">Email</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold">Nom</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold">Rôle</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold">Statut</th>
                    <th class="px-6 py-3 text-left text-sm font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y dark:divide-gray-700">
                {% if users|length > 0 %}
                    {% for user in users %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                            <td class="px-6 py-4 text-sm">{{ user.email }}</td>
                            <td class="px-6 py-4 text-sm">{{ user.name ?? '-' }}</td>
                            <td class="px-6 py-4 text-sm">
                                {% if user.isAdmin %}
                                    <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">Admin</span>
                                {% else %}
                                    <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs">Utilisateur</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-sm">
                                {% if user.isActive %}
                                    <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs">Actif</span>
                                {% else %}
                                    <span class="bg-red-100 text-red-800 px-2 py-1 rounded text-xs">Inactif</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-sm">
                                <div class="flex gap-2">
                                    {% if app.user.id != user.id %}
                                        {% if user.isActive %}
                                            <form method="POST" action="{{ path('admin_users_deactivate', {id: user.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('deactivate_user') }}">
                                                <button type="submit" class="bg-yellow-500 text-white px-3 py-1 rounded text-sm hover:bg-yellow-600 transition-colors">
                                                    Désactiver
                                                </button>
                                            </form>
                                        {% else %}
                                            <form method="POST" action="{{ path('admin_users_activate', {id: user.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('activate_user') }}">
                                                <button type="submit" class="bg-green-500 text-white px-3 py-1 rounded text-sm hover:bg-green-600 transition-colors">
                                                    Activer
                                                </button>
                                            </form>
                                        {% endif %}

                                        <form method="POST" action="{{ path('admin_users_delete', {id: user.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_user') }}">
                                            <button type="submit" class="bg-red-600 text-white px-3 py-1 rounded text-sm hover:bg-red-700 transition-colors">
                                                Supprimer
                                            </button>
                                        </form>
                                    {% else %}
                                        <span class="text-gray-500 text-sm italic">Votre compte</span>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-4 text-center text-gray-500">Aucun utilisateur trouvé</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_account') }}" class="inline-block mt-6 text-primary hover:text-secondary">
        ← Retour au Compte
    </a>
</div>
{% endblock %}




