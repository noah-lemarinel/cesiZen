{% extends 'base.html.twig' %}

{% block title %}Exercices de respiration{% endblock %}

{% block body %}
    <div class="container mx-auto px-6 py-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-3xl font-semibold mb-2">Exercices de respiration</h1>
                <p class="text-gray-600 dark:text-gray-300">Découvrez nos exercices de respiration guidée pour vous aider à vous détendre et à gérer votre stress.</p>
            </div>
            {% if app.user %}
                <a href="{{ path('exercises_create') }}" class="bg-primary text-white px-4 py-2 rounded hover:opacity-90 transition-opacity whitespace-nowrap">
                    + Créer
                </a>
            {% endif %}
        </div>

        {# Default exercises #}
        {% if exercises %}
            <div>
                <h2 class="text-2xl font-semibold mb-4 text-gray-800 dark:text-gray-100">Exercices par défaut</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                    {% for exercise in exercises %}
                        <div class="bg-white/60 dark:bg-gray-800 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow duration-200">
                            <h2 class="text-xl font-semibold mb-2">{{ exercise.name }}</h2>

                            {% if exercise.description %}
                                <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">{{ exercise.description }}</p>
                            {% endif %}

                            <div class="bg-gray-100 dark:bg-gray-700 rounded p-3 mb-4 text-sm">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-gray-700 dark:text-gray-300"><strong>Respiration:</strong></span>
                                    <span class="font-mono text-secondary">{{ exercise.inhaleSeconds }}s - {{ exercise.holdSeconds }}s - {{ exercise.exhaleSeconds }}s</span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-gray-700 dark:text-gray-300"><strong>Cycles:</strong></span>
                                    <span class="font-mono text-secondary">{{ exercise.cycles }}</span>
                                </div>
                            </div>

                            <a href="{{ path('exercises_show', {'id': exercise.id}) }}" class="inline-block bg-secondary text-white px-4 py-2 rounded hover:opacity-90 transition-opacity">
                                Commencer
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# User exercises #}
        {% if userExercises %}
            <div>
                <h2 class="text-2xl font-semibold mb-4 text-gray-800 dark:text-gray-100">Mes exercices</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for exercise in userExercises %}
                        <div class="bg-primary/10 dark:bg-primary/20 border-2 border-primary rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow duration-200">
                            <div class="flex items-start justify-between mb-2">
                                <h2 class="text-xl font-semibold">{{ exercise.name }}</h2>
                                <div class="flex gap-2">
                                    <a href="{{ path('exercises_edit', {'id': exercise.id}) }}" class="text-sm text-primary hover:opacity-70" title="Modifier">
                                        ✏️
                                    </a>
                                    <form method="POST" action="{{ path('exercises_delete', {'id': exercise.id}) }}" style="display:inline;"
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet exercice ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exercise.id) }}">
                                        <button type="submit" class="text-sm text-alert hover:opacity-70" title="Supprimer">🗑️</button>
                                    </form>
                                </div>
                            </div>

                            {% if exercise.description %}
                                <p class="text-gray-600 dark:text-gray-400 text-sm mb-4">{{ exercise.description }}</p>
                            {% endif %}

                            <div class="bg-gray-100 dark:bg-gray-700 rounded p-3 mb-4 text-sm">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-gray-700 dark:text-gray-300"><strong>Respiration:</strong></span>
                                    <span class="font-mono text-secondary">{{ exercise.inhaleSeconds }}s - {{ exercise.holdSeconds }}s - {{ exercise.exhaleSeconds }}s</span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-gray-700 dark:text-gray-300"><strong>Cycles:</strong></span>
                                    <span class="font-mono text-secondary">{{ exercise.cycles }}</span>
                                </div>
                            </div>

                            <a href="{{ path('exercises_show', {'id': exercise.id}) }}" class="inline-block bg-secondary text-white px-4 py-2 rounded hover:opacity-90 transition-opacity">
                                Commencer
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% elseif app.user %}
            <div class="py-4">
                <p class="text-gray-600 dark:text-gray-400">Vous n'avez pas encore créé vos propres exercices. <a href="{{ path('exercises_create') }}" class="text-secondary hover:underline">Créer un exercice</a></p>
            </div>
        {% endif %}

        {% if not exercises and not userExercises %}
            <div class="bg-white/60 dark:bg-gray-800 rounded p-6 text-center">
                <p class="text-gray-600 dark:text-gray-400">Aucun exercice disponible pour le moment.</p>
            </div>
        {% endif %}
    </div>
{% endblock %}

