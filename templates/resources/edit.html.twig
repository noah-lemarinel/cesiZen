{# templates/resources/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Éditer "{{ post.title }}" - Blog{% endblock %}

{% block body %}
    <div class="container mx-auto px-6 py-8">
        <div class="max-w-3xl mx-auto">
            <a href="{{ path('blog_post_show', { id: post.id }) }}" class="text-secondary hover:underline mb-6 inline-block">
                ← Retour à l'article
            </a>

            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8">
                <h1 class="text-3xl font-semibold mb-6">Éditer l'article</h1>

                {{ form_start(form) }}
                <div class="space-y-6">
                    <div>
                        {{ form_label(form.title) }}
                        {{ form_widget(form.title, { attr: { class: 'mt-2 block w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white' } }) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div>
                        {{ form_label(form.content) }}
                        {{ form_widget(form.content, { attr: { class: 'mt-2 block w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white' } }) }}
                        {{ form_errors(form.content) }}
                    </div>

                    <div class="flex gap-4">
                        <button type="submit" class="bg-secondary text-white px-6 py-2 rounded shadow hover:opacity-90">
                            Enregistrer les modifications
                        </button>
                        <a href="{{ path('blog_post_show', { id: post.id }) }}" class="bg-gray-500 text-white px-6 py-2 rounded shadow hover:opacity-90">
                            Annuler
                        </a>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}

